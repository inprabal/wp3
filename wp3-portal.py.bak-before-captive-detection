#!/usr/bin/env python3

from flask import Flask, request, session, redirect, url_for
from pathlib import Path
import ipaddress
import secrets
import subprocess

app = Flask(__name__)
app.secret_key = secrets.token_bytes(32)

AUTH_SCRIPT = Path("/usr/local/sbin/wp3-authorize")

PORTAL_HTML = """
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>WiFi Test Lab</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f2f4f7;
            margin: 0;
            padding: 30px 15px;
        }
        .container {
            max-width: 420px;
            margin: 50px auto;
            background: white;
            padding: 28px;
            border-radius: 12px;
            text-align: center;
            box-shadow: 0 3px 15px #0002;
        }
        button {
            background: #1769aa;
            color: white;
            border: 0;
            padding: 14px 28px;
            border-radius: 7px;
            font-size: 16px;
            cursor: pointer;
        }
        .notice { color: #555; line-height: 1.6; }
    </style>
</head>
<body>
<div class="container">
    <h2>WiFi Test Lab</h2>
    <p class="notice">
        You are connecting to an authorised wireless testing network.
        By continuing, you acknowledge that this is a controlled
        testing environment and agree to its use.
    </p>
    <form method="POST">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <button type="submit">Accept and Continue</button>
    </form>
</div>
</body>
</html>
"""

SUCCESS_HTML = """
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Connected</title>
</head>
<body style="font-family:Arial;text-align:center;padding:50px">
<h2>Access authorised</h2>
<p>Your device is authorised for internet access.</p>
<p>You may close this page.</p>
</body>
</html>
"""


@app.route("/", methods=["GET", "POST"])
def portal():

    client_ip = ipaddress.ip_address(request.remote_addr)

    if client_ip not in ipaddress.ip_network("172.16.0.0/24"):
        return "Invalid client network", 403

    if str(client_ip) == "172.16.0.1":
        return "Invalid client address", 403

    if request.method == "GET":
        csrf = secrets.token_urlsafe(24)
        session["csrf"] = csrf
        return PORTAL_HTML.replace(
            "{{ csrf }}", csrf
        )

    supplied = request.form.get("csrf", "")

    if not secrets.compare_digest(
        supplied, session.get("csrf", "")
    ):
        return "Invalid request", 403

    if not AUTH_SCRIPT.is_file():
        return "Authorisation service is not configured yet.", 503

    try:
        subprocess.run(
            ["/usr/bin/sudo", "-n", str(AUTH_SCRIPT), str(client_ip)],
            check=True,
            timeout=5,
            capture_output=True,
            text=True
        )
    except (subprocess.SubprocessError, OSError):
        app.logger.exception("Client authorisation failed")
        return "Authorisation failed. Contact the lab administrator.", 500

    session.clear()
    return SUCCESS_HTML


if __name__ == "__main__":
    app.run(
        host="172.16.0.1",
        port=8080,
        debug=False,
        use_reloader=False
    )
